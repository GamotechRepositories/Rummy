# ==============================================================================
# Royal Rummy â€” 21-Card Rummy Frontend (RUMMY_21) â€” `.env.example`
# Vite embeds `VITE_*` variables into the bundle during `npm run build`.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: LOCAL DEVELOPMENT (`npm run dev`)
# Leave URLs commented out to auto-detect `window.location.hostname:8081`
# (works for both localhost and LAN IPs like http://192.168.x.x:5176), OR
# uncomment below to point explicitly to localhost:8081.
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8081
# VITE_WS_URL=ws://localhost:8081/ws/game

# ------------------------------------------------------------------------------
# OPTION B: PRODUCTION BUILD (`npm run build` â€” 1 Shared Backend + Separate Frontends)
# Copy these active lines into `.env` (or `.env.production.local`) before building.
# In the shared backend, add this frontend's domain (e.g. https://21card.example.com)
# to `RUMMY_ALLOWED_ORIGINS`, `RUMMY_ORIGIN_RULESETS` (=RUMMY_21), and `RUMMY_GAME_URLS`.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.example.com
VITE_WS_URL=wss://api.example.com/ws/game
