# Frontend Environment Configuration (Vite)
# NOTE: If Frontend and Backend are hosted on the SAME server behind Nginx,
# you don't need this .env (it automatically detects window.location.origin).
# Only use this if Frontend and Backend are on DIFFERENT domains or ports.

# Backend HTTP Base URL (REST API)
VITE_API_BASE_URL=http://localhost:8081

# Backend WebSocket Game Gateway URL
VITE_WS_URL=ws://localhost:8081/ws/game
