# ==============================================================================
# RUMMY GAME-SERVICE ENVIRONMENT TEMPLATE (.env.example)
# Copy the appropriate section to `.env` (or set in your hosting dashboard).
# NEVER commit real secrets or database passwords into `.env.example`.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: LOCAL DEVELOPMENT SETUP (Default profile)
# Uncomment this section and replace `<...>` placeholders when running locally.
# ------------------------------------------------------------------------------
# PORT=8081
#
# # MongoDB (local replica set or Atlas dev cluster)
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/Rummy?appName=Cluster0
# SPRING_DATA_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/Rummy?appName=Cluster0
# RUMMY_MONGO_TRANSACTIONS=true
#
# # Local security keys (generate random 32+ char strings)
# RUMMY_ENFORCE_JWT=true
# RUMMY_JWT_SECRET=REPLACE_WITH_LOCAL_32_PLUS_CHAR_SECRET
# RUMMY_ADMIN_API_KEY=REPLACE_WITH_LOCAL_ADMIN_KEY
#
# # CORS & WebSocket origins for all local Vite dev frontends + LAN testing
# RUMMY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*
#
# # Optional HTTP POST rate limiting
# RUMMY_HTTP_RATE_LIMIT_CAPACITY=30
# RUMMY_HTTP_RATE_LIMIT_REFILL_RATE=10.0
#
# # Optional multi-port isolation when running separated frontends together on fixed ports:
# # RUMMY_ORIGIN_RULESETS=http://localhost:5173=POINTS_13;http://localhost:5174=POOL_101,POOL_201;http://localhost:5175=DEALS_RUMMY,DEALS_2,DEALS_3;http://localhost:5176=RUMMY_21
# # RUMMY_GAME_CODE_RULESETS=POINTS=POINTS_13;POOL=POOL_101,POOL_201;DEALS=DEALS_RUMMY,DEALS_2,DEALS_3;RUMMY_21=RUMMY_21
#
# # Operator launch & Mock Operator (/mock-operator/ for local test money)
# RUMMY_GAME_URL=http://localhost:5173
# # RUMMY_GAME_URLS=POINTS=http://localhost:5173;POOL=http://localhost:5174;DEALS=http://localhost:5175;RUMMY_21=http://localhost:5176
# RUMMY_MOCK_OPERATOR_ENABLED=true
#
# # Operations Service (server-to-server X-Internal-Key)
# OPERATIONS_API_URL=https://operations.dpbossking.com
# INTERNAL_SERVICE_KEY=REPLACE_WITH_INTERNAL_SERVICE_KEY
#
# # Single-node local dev
# RUMMY_REDIS_ENABLED=false
# RUMMY_DRAIN_TIMEOUT_SECONDS=20
# RUMMY_SHUTDOWN_PHASE_TIMEOUT=25s
# RUMMY_RECOVERY_ENABLED=true
# RUMMY_SNAPSHOT_INTERVAL_MS=1000
# RUMMY_RESTORE_WINDOW_SECONDS=300
# RUMMY_NODE_DEAD_AFTER_SECONDS=45

# ------------------------------------------------------------------------------
# OPTION B: PRODUCTION SETUP — 1 Shared Live Backend + 4 Separate Live Frontends
# Use these keys in your live server `.env` / hosting environment variables.
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8081

# Single live backend server: false | Multi-node cluster/Kubernetes: true (+ REDIS_URL)
RUMMY_REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# MongoDB replica-set URI (transactions must be true on live replica sets)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/Rummy?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/Rummy?retryWrites=true&w=majority
RUMMY_MONGO_TRANSACTIONS=true

# Security — MUST generate fresh random 32+ char secrets (different from local!)
RUMMY_ENFORCE_JWT=true
RUMMY_JWT_SECRET=REPLACE_WITH_PRODUCTION_32_PLUS_CHAR_RANDOM_SECRET
RUMMY_ADMIN_API_KEY=REPLACE_WITH_PRODUCTION_STRONG_RANDOM_ADMIN_KEY

# Disable test-money mock operator on real-money production
RUMMY_MOCK_OPERATOR_ENABLED=false
# Only if staging needs mock operator under prod profile, set 12+ char access key & base URL:
# RUMMY_MOCK_OPERATOR_KEY=REPLACE_WITH_12_PLUS_CHAR_ACCESS_KEY
# RUMMY_OPERATOR_MOCK_BASE_URL=https://api.example.com

# HTTP POST rate limiting (requests burst / refill per second per player/IP)
RUMMY_HTTP_RATE_LIMIT_CAPACITY=30
RUMMY_HTTP_RATE_LIMIT_REFILL_RATE=10.0

# CORS & WebSocket allowed origins — list ALL live frontend domains (comma-separated)
RUMMY_ALLOWED_ORIGINS=https://points.example.com,https://pool.example.com,https://deals.example.com,https://21card.example.com

# Server-side variant isolation: lock each frontend origin (and/or provider gameCode) to its rulesets
RUMMY_ORIGIN_RULESETS=https://points.example.com=POINTS_13;https://pool.example.com=POOL_101,POOL_201;https://deals.example.com=DEALS_RUMMY,DEALS_2,DEALS_3;https://21card.example.com=RUMMY_21
# Optional: also lock by operator launch `gameCode` (combined with origin rules via intersection)
# RUMMY_GAME_CODE_RULESETS=POINTS=POINTS_13;POOL=POOL_101,POOL_201;DEALS=DEALS_RUMMY,DEALS_2,DEALS_3;RUMMY_21=RUMMY_21

# Operator launch routing: fallback URL + per-gameCode frontend URLs
RUMMY_GAME_URL=https://points.example.com
RUMMY_GAME_URLS=POINTS=https://points.example.com;POOL=https://pool.example.com;DEALS=https://deals.example.com;RUMMY_21=https://21card.example.com

# Operations Service (server-to-server X-Internal-Key)
OPERATIONS_API_URL=https://operations.dpbossking.com
INTERNAL_SERVICE_KEY=REPLACE_WITH_INTERNAL_SERVICE_KEY

# Production graceful shutdown & crash recovery
RUMMY_DRAIN_TIMEOUT_SECONDS=270
RUMMY_SHUTDOWN_PHASE_TIMEOUT=285s
RUMMY_RECOVERY_ENABLED=true
RUMMY_SNAPSHOT_INTERVAL_MS=1000
RUMMY_RESTORE_WINDOW_SECONDS=300
RUMMY_NODE_DEAD_AFTER_SECONDS=45
